# Copy to .env and edit. Never commit .env.
DOMAIN=studio.example.com
BASE_URL=https://studio.example.com

# 1 while you create your own account, then set to 0 to close public sign-ups
ALLOW_REGISTRATION=1

# Needed for password-reset emails. Any SMTP provider works. Leave SMTP_HOST empty and links are only printed in the server log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Email Impact Studio <no-reply@example.com>
SMTP_SECURITY=starttls
